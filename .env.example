# Скопируйте в .env и заполните. Файл .env в git не попадает.

# База данных (postgres://пользователь:пароль@хост:порт/имя)
DATABASE_URL=postgres://aether:CHANGE_ME@postgres:5432/aether

# Кэш и сессии (необязательно; без него кэш локальный, сессии в базе)
# redis://:пароль@хост:порт/номер_базы. Пароль со спецсимволами кодируйте (%40 для @)
REDIS_URL=redis://:CHANGE_ME@redis:6379/1

# Django. Для сервера: DEBUG=False и свой SECRET_KEY
# (python -c "from django.core.management.utils import get_random_secret_key as k; print(k())")
DEBUG=True
SECRET_KEY=

# Адреса. По умолчанию рассчитаны на разработку через code-server.
# На сервере: свой домен, FORCE_SCRIPT_NAME пустой, STATIC_URL можно не задавать (/static/).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8443
FORCE_SCRIPT_NAME=/proxy/8000
# STATIC_URL=/static/
# STATIC_ROOT=/var/www/aether/static

# Вход через Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Nextcloud (хранилище ассетов)
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
